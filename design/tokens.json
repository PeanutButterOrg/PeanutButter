{
  "$comment": "PeanutButter design tokens: the one source of colours, type, spacing, corners and motion for every app. Edit here, then run scripts/gen-design-tokens.py. Desktop sizes are logical pixels at a 1440x900 window; TV sizes are dp/sp on a 1920x1080 TV (960x540 dp), sized for viewing from the sofa.",
  "color": {
    "ground":         { "value": "#0E0E12", "note": "Page background, behind everything" },
    "surface":        { "value": "#16171D", "note": "Cards, panels, menus" },
    "surfaceRaised":  { "value": "#1E2028", "note": "Hovered or selected surface, inputs" },
    "line":           { "value": "#2A2D37", "note": "Hairlines and outlines" },
    "text":           { "value": "#F1F3F7", "note": "Main text" },
    "textMuted":      { "value": "#A7ADBB", "note": "Secondary text, captions" },
    "textFaint":      { "value": "#6E7483", "note": "Hints, disabled text" },
    "primary":        { "value": "#E2A456", "note": "Peanut amber: the main action (Play, Save) and active chips" },
    "primaryPressed": { "value": "#C98A3E", "note": "Primary while pressed" },
    "onPrimary":      { "value": "#1A1206", "note": "Text and icons on primary" },
    "focus":          { "value": "#F1F3F7", "note": "Focus ring (keyboard / remote): soft white, like the text" },
    "focusSoft":      { "value": "#3A3D48", "note": "Focused surface tint on TV" },
    "brand":          { "value": "#5B9FFF", "note": "The blue 'Butter' in the logo" },
    "good":           { "value": "#4ADE80", "note": "Healthy, done, on" },
    "warn":           { "value": "#FBBF24", "note": "Weak, attention" },
    "bad":            { "value": "#F87171", "note": "Errors, dead, destructive" },
    "rt":             { "value": "#FA320A", "note": "Rotten Tomatoes red, only on its badge" },
    "scrimTop":       { "value": "#F20E0E12", "note": "Top bar once content scrolls under it" },
    "scrimHero":      { "value": "#E60E0E12", "note": "Hero fade behind text" }
  },
  "font": {
    "display": { "family": "Space Grotesk", "fallback": "Inter, system-ui, sans-serif", "note": "Titles, section headings, hero names" },
    "body":    { "family": "Inter", "fallback": "system-ui, Roboto, sans-serif", "note": "Everything else" }
  },
  "type": {
    "hero":    { "font": "display", "weight": 700, "desktop": 52, "tv": 44, "line": 1.0,  "tracking": -0.5, "note": "Title name on the hero and title page" },
    "h1":      { "font": "display", "weight": 700, "desktop": 34, "tv": 32, "line": 1.1,  "tracking": -0.3, "note": "Page titles (My List, Explore, Settings)" },
    "h2":      { "font": "display", "weight": 600, "desktop": 22, "tv": 24, "line": 1.2,  "tracking": 0,    "note": "Row and section headings" },
    "title":   { "font": "body",    "weight": 600, "desktop": 16, "tv": 18, "line": 1.3,  "tracking": 0,    "note": "Card titles, list items" },
    "body":    { "font": "body",    "weight": 400, "desktop": 14, "tv": 16, "line": 1.5,  "tracking": 0,    "note": "Synopsis, descriptions" },
    "meta":    { "font": "body",    "weight": 500, "desktop": 13, "tv": 15, "line": 1.35, "tracking": 0,    "note": "Year, runtime, rating line" },
    "label":   { "font": "body",    "weight": 700, "desktop": 11, "tv": 12, "line": 1.2,  "tracking": 0.8,  "note": "Uppercase eyebrows and badges" },
    "button":  { "font": "body",    "weight": 600, "desktop": 14, "tv": 16, "line": 1.0,  "tracking": 0,    "note": "Buttons and chips" }
  },
  "space": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 48, "gutterDesktop": 36, "gutterTv": 48 },
  "radius": { "badge": 6, "card": 10, "panel": 16, "pill": 999 },
  "size": {
    "posterWidthDesktop": 150, "posterWidthTv": 132,
    "wideCardWidthDesktop": 300, "wideCardWidthTv": 268,
    "buttonHeightDesktop": 38, "buttonHeightTv": 48,
    "topBarHeightDesktop": 60, "topBarHeightTv": 72,
    "focusRing": 3, "focusRingOffset": 3, "focusScaleTv": 1.06
  },
  "motion": { "fast": 120, "base": 180, "slow": 280 }
}
