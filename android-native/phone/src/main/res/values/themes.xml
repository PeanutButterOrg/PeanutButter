<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PeanutButter.Phone" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/pb_seed</item>
        <item name="colorOnPrimary">@color/pb_white</item>
        <item name="colorSecondary">@color/pb_seed</item>
        <item name="colorSurface">@color/pb_panel</item>
        <item name="colorOnSurface">@color/pb_white</item>
        <item name="android:colorBackground">@color/pb_canvas</item>
        <item name="android:statusBarColor">@color/pb_canvas</item>
        <item name="android:navigationBarColor">@color/pb_canvas</item>
        <item name="android:windowBackground">@color/pb_canvas</item>
        <item name="materialButtonStyle">@style/Pb.Phone.Button</item>
        <item name="textInputStyle">@style/Pb.Phone.TextInput</item>
    </style>

    <style name="Pb.Phone.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/pb_seed</item>
    </style>

    <style name="Pb.Phone.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/pb_field</item>
        <item name="boxStrokeColor">@color/pb_seed</item>
    </style>
</resources>
