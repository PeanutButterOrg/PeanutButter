<?xml version="1.0" encoding="utf-8"?>
<!-- An episode, as on desktop: the still (progress, watched tick), then
     "2. Name", the runtime and two lines of the synopsis. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <!-- Face scales on focus; duplicateParentState so focus ring tracks outer focus -->
    <FrameLayout
        android:id="@+id/episode_face"
        android:layout_width="match_parent"
        android:layout_height="161dp"
        android:background="@drawable/poster_card_bg"
        android:duplicateParentState="true"
        android:foreground="@drawable/poster_focus_ring">

        <ImageView
            android:id="@+id/episode_still"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:duplicateParentState="true"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/episode_watched"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/badge_watched"
            android:contentDescription="@string/watched"
            android:padding="2dp"
            android:src="@drawable/ic_check"
            android:tint="@color/pb_completed"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/episode_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressBackgroundTint="#3DFFFFFF"
            android:progressTint="@color/pbt_primary"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/episode_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pbt_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/episode_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/pbt_text_muted"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/episode_overview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:textColor="@color/pbt_text_faint"
        android:textSize="13sp" />
</LinearLayout>
