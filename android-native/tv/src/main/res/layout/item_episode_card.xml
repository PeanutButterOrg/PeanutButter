<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="212dp"
    android:layout_height="120dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:paddingStart="0dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <!-- Face scales on focus; duplicateParentState so focus ring tracks outer focus -->
    <FrameLayout
        android:id="@+id/episode_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/poster_card_bg"
        android:duplicateParentState="true"
        android:foreground="@drawable/poster_focus_ring">

        <ImageView
            android:id="@+id/episode_still"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:duplicateParentState="true"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/episode_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/pb_seed"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/episode_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/pb_white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/episode_watched"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/badge_watched"
            android:contentDescription="@string/watched"
            android:padding="2dp"
            android:src="@drawable/ic_check"
            android:tint="@color/pb_completed"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/episode_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressBackgroundTint="#3DFFFFFF"
            android:progressTint="@color/pb_seed"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
