<?xml version="1.0" encoding="utf-8"?>
<!-- "Continue watching" when a title opens part-way in, as on desktop. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingTop="22dp"
    android:paddingEnd="26dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.12"
        android:text="@string/resume_eyebrow"
        android:textColor="@color/pbt_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/resume_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/pbt_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/resume_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"
        android:max="1000"
        android:progressBackgroundTint="#29FFFFFF"
        android:progressTint="@color/pbt_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/resume_at"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/pbt_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resume_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/pbt_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/resume_continue"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="3"
            android:background="@drawable/bg_button_primary"
            android:drawableStart="@drawable/ic_play_arrow"
            android:drawablePadding="6dp"
            android:drawableTint="@color/pbt_on_primary"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:textColor="@color/pbt_on_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resume_restart"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="2"
            android:background="@drawable/bg_button_ghost"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="@string/resume_start_over"
            android:textColor="@color/pbt_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
