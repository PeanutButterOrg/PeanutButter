<?xml version="1.0" encoding="utf-8"?>
<!-- One source: quality box, health and size, play dot. Desktop: _TorrentTile. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/source_tile_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="58dp"
        android:layout_height="54dp"
        android:background="@drawable/quality_box"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/q_res"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.Pb.H2"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/q_src"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.Pb.Label"
            android:textColor="@color/pbt_primary"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <app.peanutbutter.tv.ui.SignalBarsView
                android:id="@+id/bars"
                android:layout_width="18dp"
                android:layout_height="13dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Pb.Meta"
                android:textColor="@color/pbt_text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tag_best"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/best_tag"
                android:paddingHorizontal="7dp"
                android:paddingVertical="1dp"
                android:text="@string/best"
                android:textAppearance="@style/TextAppearance.Pb.Label"
                android:textColor="@color/pbt_on_primary"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/spec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Pb.Title"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/origin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Pb.Meta"
            android:textColor="@color/pbt_text_faint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/source_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Pb.Meta"
            android:textColor="@color/pbt_text_faint"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/play_dot"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/play_dot_alt">

        <ImageView
            android:id="@+id/play_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_play_arrow"
            android:tint="@color/pbt_text" />
    </FrameLayout>
</LinearLayout>
