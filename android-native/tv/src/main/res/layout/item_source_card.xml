<?xml version="1.0" encoding="utf-8"?>
<!-- Flutter _TorrentTile — full-width of dialog list, wrap chips -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/source_tile_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tag_best"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/source_tag_emphasized"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="@string/best_match"
            android:textColor="@color/pb_seed"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tag_health"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/source_tag_muted"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/pb_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tag_tracker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/source_tag_muted"
            android:ellipsize="end"
            android:maxWidth="220dp"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/pb_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/play_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_play_arrow"
            android:tint="@color/pb_seed" />
    </LinearLayout>

    <TextView
        android:id="@+id/source_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.25"
        android:maxLines="2"
        android:textColor="@color/pb_white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/source_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pb_muted"
        android:textSize="13sp" />
</LinearLayout>
