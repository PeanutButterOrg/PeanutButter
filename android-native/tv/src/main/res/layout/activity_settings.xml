<?xml version="1.0" encoding="utf-8"?>
<!-- Same sections and order as the desktop app's Settings: Playback, Library &
     sources, Subtitles, This device, About. Each section is a card of rows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pb_canvas">

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/shelf_inset"
        android:paddingTop="28dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textColor="@color/pb_white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Playback -->
            <TextView
                style="@style/SettingsSectionTitle"
                android:text="@string/settings_playback" />

            <LinearLayout style="@style/SettingsCard">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/video_quality" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="@string/video_quality_hint" />

                <LinearLayout
                    android:id="@+id/quality_chips"
                    style="@style/SettingsChips" />

                <View style="@style/SettingsDivider" />

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/android_player" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="@string/player_hint" />

                <LinearLayout
                    android:id="@+id/player_chips"
                    style="@style/SettingsChips" />
            </LinearLayout>

            <!-- Library & sources -->
            <TextView
                style="@style/SettingsSectionTitle"
                android:text="@string/settings_library" />

            <LinearLayout style="@style/SettingsCard">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/languages" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="@string/languages_hint" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/language_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/language_value"
                    style="@style/SettingsValue" />

                <View style="@style/SettingsDivider" />

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/settings_server" />

                <TextView
                    android:id="@+id/server_url"
                    style="@style/SettingsHint"
                    android:textColor="@color/pb_white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/server_info"
                    style="@style/SettingsValue" />

                <TextView
                    android:id="@+id/jackett_status"
                    style="@style/SettingsValue"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Subtitles -->
            <TextView
                style="@style/SettingsSectionTitle"
                android:text="@string/subs_title" />

            <LinearLayout style="@style/SettingsCard">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/opensubtitles" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="@string/opensubtitles_hint" />

                <LinearLayout
                    android:id="@+id/opensub_chips"
                    style="@style/SettingsChips" />

                <EditText
                    android:id="@+id/opensub_key"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_field"
                    android:hint="@string/subs_key_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/pb_white"
                    android:textColorHint="@color/pb_muted"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/wyzie_key"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_field"
                    android:hint="@string/subs_wyzie_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/pb_white"
                    android:textColorHint="@color/pb_muted"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/opensub_save"
                    style="@style/SettingsButtonPrimary"
                    android:text="@string/subs_save" />

                <TextView
                    android:id="@+id/opensub_status"
                    style="@style/SettingsValue" />
            </LinearLayout>

            <!-- This device -->
            <TextView
                style="@style/SettingsSectionTitle"
                android:text="@string/settings_device" />

            <LinearLayout style="@style/SettingsCard">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/clear_cache_on_exit" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="@string/clear_cache_on_exit_hint" />

                <LinearLayout
                    android:id="@+id/clear_cache_chips"
                    style="@style/SettingsChips" />

                <View style="@style/SettingsDivider" />

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/downloaded_streams" />

                <TextView
                    android:id="@+id/downloads_size"
                    style="@style/SettingsHint" />

                <TextView
                    android:id="@+id/clear_now"
                    style="@style/SettingsButtonGhost"
                    android:text="@string/clear_now" />
            </LinearLayout>

            <!-- About -->
            <TextView
                style="@style/SettingsSectionTitle"
                android:text="@string/settings_about" />

            <LinearLayout style="@style/SettingsCard">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/app_version" />

                <TextView
                    android:id="@+id/app_version"
                    style="@style/SettingsHint" />

                <TextView
                    android:id="@+id/check_updates"
                    style="@style/SettingsButtonGhost"
                    android:text="@string/check_for_updates" />

                <View style="@style/SettingsDivider" />

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/server_version" />

                <TextView
                    android:id="@+id/server_version"
                    style="@style/SettingsHint" />

                <View style="@style/SettingsDivider" />

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/disconnect" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="@string/disconnect_hint" />

                <TextView
                    android:id="@+id/disconnect"
                    style="@style/SettingsButtonGhost"
                    android:text="@string/disconnect" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#990E0E12"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/pb_seed" />
    </FrameLayout>
</FrameLayout>
