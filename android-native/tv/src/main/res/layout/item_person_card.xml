<?xml version="1.0" encoding="utf-8"?>
<!-- Flutter _CastTile: 104×148 photo + name + role — scale/elevation only, no stroke -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="122dp"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/person_face"
        android:layout_width="104dp"
        android:layout_height="148dp"
        android:background="@drawable/poster_card_bg"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/person_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/person_name"
        android:layout_width="104dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pb_white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/person_role"
        android:layout_width="104dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/pb_muted"
        android:textSize="11sp" />
</LinearLayout>
