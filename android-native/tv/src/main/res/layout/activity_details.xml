<?xml version="1.0" encoding="utf-8"?>
<!-- Flutter DetailScreen: scrollable hero → cast → trailer → seasons -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pb_canvas"
    android:clipChildren="false">

    <ScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/detail_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <!-- Hero (Flutter HeroBannerFrame ~58% viewport) -->
            <FrameLayout
                android:id="@+id/hero_frame"
                android:layout_width="match_parent"
                android:layout_height="520dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hero_scrim_left" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hero_scrim_bottom" />

                <LinearLayout
                    android:id="@+id/hero_copy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="@dimen/shelf_inset"
                    android:layout_marginEnd="@dimen/shelf_inset"
                    android:layout_marginBottom="28dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextAppearance.Pb.Label"
                        android:textColor="@color/pbt_primary" />

                    <ImageView
                        android:id="@+id/logo"
                        android:layout_width="260dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="680dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Pb.Hero" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/meta_chips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/synopsis"
                        android:layout_width="680dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:ellipsize="end"
                        android:lineSpacingMultiplier="1.35"
                        android:maxLines="3"
                        android:textAppearance="@style/TextAppearance.Pb.Body"
                        android:textColor="#FFD6DAE3" />

                    <LinearLayout
                        android:id="@+id/action_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/btn_play"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_button_primary"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:minWidth="120dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="20dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_play_arrow"
                                android:tint="@color/pbt_on_primary" />

                            <TextView
                                android:id="@+id/btn_play_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/play"
                                android:textAppearance="@style/TextAppearance.Pb.Button"
                                android:textColor="@color/pbt_on_primary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btn_from_start"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_button_ghost"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center"
                            android:minWidth="120dp"
                            android:paddingHorizontal="16dp"
                            android:text="@string/from_start"
                            android:textAppearance="@style/TextAppearance.Pb.Button"
                            android:textColor="@color/pbt_text"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/btn_watched"
                            style="@style/PbPillButton">

                            <ImageView
                                android:id="@+id/btn_watched_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_outline"
                                android:tint="@color/pbt_text" />

                            <TextView
                                android:id="@+id/btn_watched_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/mark_watched"
                                android:textAppearance="@style/TextAppearance.Pb.Button"
                                android:textColor="@color/pbt_text" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btn_favorite"
                            style="@style/PbPillButton">

                            <ImageView
                                android:id="@+id/btn_favorite_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_add"
                                android:tint="@color/pbt_text" />

                            <TextView
                                android:id="@+id/btn_favorite_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/my_list"
                                android:textAppearance="@style/TextAppearance.Pb.Button"
                                android:textColor="@color/pbt_text" />
                        </LinearLayout>

                        <!-- Series only: notify me of new episodes. -->
                        <LinearLayout
                            android:id="@+id/btn_follow"
                            style="@style/PbPillButton"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/btn_follow_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_notifications_none"
                                android:tint="@color/pbt_text" />

                            <TextView
                                android:id="@+id/btn_follow_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/follow"
                                android:textAppearance="@style/TextAppearance.Pb.Button"
                                android:textColor="@color/pbt_text" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Cast, Director, Writers lines (as on desktop) -->
            <TextView
                android:id="@+id/credits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/shelf_inset"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/shelf_inset"
                android:lineSpacingMultiplier="1.4"
                android:textAppearance="@style/TextAppearance.Pb.Meta"
                android:visibility="gone" />

            <!-- Cast & crew -->
            <TextView
                android:id="@+id/cast_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/shelf_inset"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/shelf_inset"
                android:text="@string/cast_crew"
                android:textAppearance="@style/TextAppearance.Pb.H2"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cast_list"
                android:layout_width="match_parent"
                android:layout_height="248dp"
                android:layout_marginTop="2dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingStart="@dimen/shelf_inset"
                android:paddingTop="6dp"
                android:paddingEnd="@dimen/shelf_inset"
                android:paddingBottom="6dp"
                android:scrollbars="none"
                android:visibility="gone" />

            <!-- Trailer — Flutter: scale + elevation, no stroke -->
            <TextView
                android:id="@+id/trailer_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/shelf_inset"
                android:layout_marginTop="8dp"
                android:text="@string/trailer"
                android:textAppearance="@style/TextAppearance.Pb.H2"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/trailer_wrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/shelf_inset"
                android:layout_marginTop="2dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="4dp"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/trailer_card"
                    android:layout_width="220dp"
                    android:layout_height="124dp"
                    android:background="@drawable/poster_card_bg"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true">

                    <ImageView
                        android:id="@+id/trailer_thumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_play_arrow"
                        android:tint="@color/pb_white" />
                </FrameLayout>
            </FrameLayout>

            <!-- Seasons (Flutter ExpansionTile list) -->
            <TextView
                android:id="@+id/seasons_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/shelf_inset"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/shelf_inset"
                android:text="@string/seasons"
                android:textAppearance="@style/TextAppearance.Pb.H2"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/seasons_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- More like this (TMDB recommendations) -->
            <TextView
                android:id="@+id/similar_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/shelf_inset"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/shelf_inset"
                android:text="@string/more_like_this"
                android:textAppearance="@style/TextAppearance.Pb.H2"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/similar_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/shelf_inset"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/shelf_inset"
                android:paddingBottom="32dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/similar_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/busy_block"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/busy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/pb_seed" />

        <TextView
            android:id="@+id/busy_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="64dp"
            android:gravity="center"
            android:text="@string/finding_sources"
            android:textColor="#E6FFFFFF"
            android:textSize="18sp" />
    </FrameLayout>
</FrameLayout>
