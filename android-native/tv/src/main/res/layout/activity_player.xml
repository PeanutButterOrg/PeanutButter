<?xml version="1.0" encoding="utf-8"?>
<!-- Layered player chrome: buffering banner ≠ transport ≠ Skip/Next. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clipChildren="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:keepScreenOn="true">

    <androidx.media3.ui.AspectRatioFrameLayout
        android:id="@+id/video_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <SurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.media3.ui.AspectRatioFrameLayout>

    <!-- Full-bleed captions (not letterboxed with the video) so they sit at the
         bottom of the TV frame. Chrome layers below are elevated above this. -->
    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="2dp" />

    <FrameLayout
        android:id="@+id/poster_hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pb_panel"
        android:visibility="visible">

        <ImageView
            android:id="@+id/poster_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/player_poster_scrim" />
    </FrameLayout>

    <!-- Top: back / title / status on the left, track + aspect buttons on
         the right (desktop player layout). -->
    <LinearLayout
        android:id="@+id/chrome_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/player_chrome_top_scrim"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="36dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/pb_white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_audio"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/player_control_btn"
                android:contentDescription="@string/audio_button"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/seek"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_language"
                android:visibility="gone"
                android:tint="@color/pb_white" />

            <ImageButton
                android:id="@+id/btn_subs"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/player_control_btn"
                android:contentDescription="@string/subs_button"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/seek"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_subtitles"
                android:visibility="gone"
                android:tint="@color/pb_white" />

            <ImageButton
                android:id="@+id/btn_aspect"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/player_control_btn"
                android:contentDescription="@string/aspect_button"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/seek"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_aspect_ratio"
                android:visibility="gone"
                android:tint="@color/pb_white" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/top_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="12dp"
            android:indeterminate="false"
            android:max="100"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/pb_seed"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Skip / Next: own layer — stays visible when transport is hidden. -->
    <LinearLayout
        android:id="@+id/overlay_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="56dp"
        android:clipChildren="false"
        android:elevation="28dp"
        android:gravity="start"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btn_skip"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_player_chip"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="148dp"
            android:nextFocusLeft="@id/btn_play"
            android:nextFocusDown="@id/btn_next"
            android:drawableEnd="@drawable/ic_skip_next"
            android:drawablePadding="8dp"
            android:paddingHorizontal="22dp"
            android:textColor="@color/pb_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_next"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_player_chip"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="148dp"
            android:nextFocusLeft="@id/btn_play"
            android:nextFocusUp="@id/btn_skip"
            android:drawableStart="@drawable/ic_skip_next"
            android:drawablePadding="8dp"
            android:paddingHorizontal="22dp"
            android:text="@string/play_next"
            android:textColor="@color/pb_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Stream stats (speed / peers / buffer), above the transport like the
         desktop player's chip. -->
    <TextView
        android:id="@+id/stats_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="176dp"
        android:background="@drawable/player_stats_chip"
        android:elevation="9dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:textColor="@color/pb_white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Bottom transport: scrubber pill + ±10 / play, as on desktop. -->
    <LinearLayout
        android:id="@+id/chrome_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_chrome_bottom_scrim"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/player_seek_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/time_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="0:00"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:foreground="@drawable/seek_focus"
                android:max="1000"
                android:minHeight="28dp"
                android:nextFocusUp="@id/btn_subs"
                android:nextFocusDown="@id/btn_play"
                android:paddingVertical="10dp"
                android:progressBackgroundTint="#3DFFFFFF"
                android:progressTint="@color/pb_seed"
                android:secondaryProgressTint="#66FFFFFF"
                android:thumbTint="@color/pb_white" />

            <TextView
                android:id="@+id/time_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="56dp"
                android:text="0:00"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_rew"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/player_control_btn"
                android:contentDescription="@string/rewind"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn_skip"
                android:nextFocusRight="@id/btn_play"
                android:nextFocusUp="@id/seek"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_replay_10"
                android:tint="@color/pb_white" />

            <ImageButton
                android:id="@+id/btn_play"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="22dp"
                android:background="@drawable/player_control_btn"
                android:contentDescription="@string/play"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn_rew"
                android:nextFocusRight="@id/btn_ff"
                android:nextFocusUp="@id/seek"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_arrow"
                android:tint="@color/pb_white" />

            <ImageButton
                android:id="@+id/btn_ff"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/player_control_btn"
                android:contentDescription="@string/forward"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn_play"
                android:nextFocusRight="@id/btn_skip"
                android:nextFocusUp="@id/seek"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_forward_10"
                android:tint="@color/pb_white" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/busy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/pb_seed" />
</FrameLayout>
