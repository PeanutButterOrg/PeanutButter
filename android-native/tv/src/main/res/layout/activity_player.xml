<?xml version="1.0" encoding="utf-8"?>
<!-- Layered player chrome: buffering banner ≠ transport ≠ Skip/Next. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clipChildren="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:keepScreenOn="true">

    <androidx.media3.ui.AspectRatioFrameLayout
        android:id="@+id/video_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <SurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.media3.ui.AspectRatioFrameLayout>

    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/poster_hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pb_panel"
        android:visibility="visible">

        <ImageView
            android:id="@+id/poster_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/player_poster_scrim" />
    </FrameLayout>

    <!-- Top: title / status / buffer — independent of transport. -->
    <LinearLayout
        android:id="@+id/chrome_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/player_chrome_top_scrim"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="28dp"
        android:paddingEnd="36dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_aspect"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_player_chip"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:minWidth="96dp"
                android:nextFocusRight="@id/btn_subs"
                android:nextFocusDown="@id/seek"
                android:paddingHorizontal="16dp"
                android:text="@string/aspect_button"
                android:textColor="@color/pb_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_subs"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_player_chip"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:minWidth="112dp"
                android:nextFocusLeft="@id/btn_aspect"
                android:nextFocusDown="@id/seek"
                android:paddingHorizontal="16dp"
                android:text="@string/subs_button"
                android:textColor="@color/pb_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/top_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="12dp"
            android:indeterminate="false"
            android:max="100"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/pb_seed"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Skip / Next: own layer — stays visible when transport is hidden. -->
    <LinearLayout
        android:id="@+id/overlay_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="56dp"
        android:clipChildren="false"
        android:elevation="28dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btn_skip"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_player_chip"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="148dp"
            android:nextFocusLeft="@id/btn_play"
            android:nextFocusDown="@id/btn_next"
            android:paddingHorizontal="22dp"
            android:textColor="@color/pb_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_next"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_player_chip"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="148dp"
            android:nextFocusLeft="@id/btn_play"
            android:nextFocusUp="@id/btn_skip"
            android:paddingHorizontal="22dp"
            android:text="@string/play_next"
            android:textColor="@color/pb_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom transport — only when user asks for controls. -->
    <LinearLayout
        android:id="@+id/chrome_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_chrome_bottom_scrim"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <SeekBar
            android:id="@+id/seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:foreground="@drawable/seek_focus"
            android:max="1000"
            android:minHeight="28dp"
            android:nextFocusUp="@id/btn_aspect"
            android:nextFocusDown="@id/btn_play"
            android:paddingVertical="10dp"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/pb_seed"
            android:secondaryProgressTint="#66FFFFFF"
            android:thumbTint="@color/pb_white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/time_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/time_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_rew"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/player_control_btn"
                android:contentDescription="@string/rewind"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btn_play"
                android:nextFocusUp="@id/seek"
                android:nextFocusLeft="@id/btn_skip"
                android:padding="13dp"
                android:src="@drawable/ic_replay_10"
                android:tint="@color/pb_white" />

            <ImageButton
                android:id="@+id/btn_play"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/player_control_btn"
                android:contentDescription="@string/play"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn_rew"
                android:nextFocusRight="@id/btn_ff"
                android:nextFocusUp="@id/seek"
                android:padding="14dp"
                android:src="@drawable/ic_play_arrow"
                android:tint="@color/pb_white" />

            <ImageButton
                android:id="@+id/btn_ff"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/player_control_btn"
                android:contentDescription="@string/forward"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn_play"
                android:nextFocusRight="@id/btn_skip"
                android:nextFocusUp="@id/seek"
                android:padding="13dp"
                android:src="@drawable/ic_forward_10"
                android:tint="@color/pb_white" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/busy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/pb_seed" />
</FrameLayout>
