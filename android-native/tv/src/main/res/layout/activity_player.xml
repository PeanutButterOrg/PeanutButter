<?xml version="1.0" encoding="utf-8"?>
<!-- Video, captions, then the Compose overlay. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clipChildren="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:keepScreenOn="true">

    <androidx.media3.ui.AspectRatioFrameLayout
        android:id="@+id/video_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <SurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.media3.ui.AspectRatioFrameLayout>

    <!-- Full-bleed captions (not letterboxed with the video) so they sit at the
         bottom of the TV frame. Chrome layers below are elevated above this. -->
    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="2dp" />

    <!-- Everything over the video (controls, menus, cards) is Compose:
         player/PlayerUi.kt, drawn like the desktop player. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/player_ui"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="4dp"
        android:focusable="false" />
</FrameLayout>
