<?xml version="1.0" encoding="utf-8"?>
<!-- Flutter home header: KindSwitch + Favourites/Watched/Search/Settings -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kind_switch_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/home_header_gradient"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/kind_movies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/kind_tab_bg"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="44dp"
        android:minWidth="72dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/movies"
        android:textColor="@color/pb_seed"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/kind_series"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/kind_tab_bg"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="44dp"
        android:minWidth="72dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/series"
        android:textColor="@color/pb_muted"
        android:textSize="16sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/btn_favourites"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/header_icon_bg"
        android:contentDescription="@string/favourites"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="10dp"
        android:src="@drawable/ic_favorite"
        android:tint="@color/pb_white" />

    <ImageButton
        android:id="@+id/btn_watched"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/header_icon_bg"
        android:contentDescription="@string/watched"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="10dp"
        android:src="@drawable/ic_watched"
        android:tint="@color/pb_white" />

    <ImageButton
        android:id="@+id/btn_search"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/header_icon_bg"
        android:contentDescription="@string/search"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="10dp"
        android:src="@drawable/ic_search"
        android:tint="@color/pb_white" />

    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/header_icon_bg"
        android:contentDescription="@string/settings"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="10dp"
        android:src="@drawable/ic_settings"
        android:tint="@color/pb_white" />
</LinearLayout>
