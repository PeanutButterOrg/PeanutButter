<?xml version="1.0" encoding="utf-8"?>
<!-- Top bar, same on every app: logo, Home · Movies · Series · My List · Explore,
     search and the device square (profile switcher later). design/tokens.json -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kind_switch_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/home_header_gradient"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/pbt_size_top_bar_height_tv"
    android:orientation="horizontal"
    android:paddingStart="@dimen/pbt_space_gutter_tv"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/pbt_space_gutter_tv"
    android:paddingBottom="12dp">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@null"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="28dp"
        android:textAppearance="@style/TextAppearance.Pb.H2"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tab_home"
        style="@style/PbTopTab"
        android:text="@string/home" />

    <TextView
        android:id="@+id/kind_movies"
        style="@style/PbTopTab"
        android:text="@string/movies" />

    <TextView
        android:id="@+id/kind_series"
        style="@style/PbTopTab"
        android:text="@string/series" />

    <TextView
        android:id="@+id/tab_mylist"
        style="@style/PbTopTab"
        android:text="@string/my_list" />

    <TextView
        android:id="@+id/tab_explore"
        style="@style/PbTopTab"
        android:text="@string/explore" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/btn_search"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/header_icon_bg"
        android:contentDescription="@string/search"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_search"
        android:tint="@color/pbt_text" />

    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/device_square"
        android:contentDescription="@string/this_device"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_person"
        android:tint="@color/pbt_on_primary" />
</LinearLayout>
