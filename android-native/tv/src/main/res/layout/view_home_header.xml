<?xml version="1.0" encoding="utf-8"?>
<!-- Flutter KindSwitch row — Movies | Series as TextButtons -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/home_header_gradient"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/kind_movies"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="64dp"
            android:nextFocusDown="@id/main_browse_fragment"
            android:paddingHorizontal="14dp"
            android:text="@string/movies"
            android:textColor="@color/pb_seed"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kind_series"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="64dp"
            android:nextFocusDown="@id/main_browse_fragment"
            android:paddingHorizontal="14dp"
            android:text="@string/series"
            android:textColor="@color/pb_muted"
            android:textSize="15sp"
            android:textStyle="normal" />
    </LinearLayout>
</FrameLayout>
