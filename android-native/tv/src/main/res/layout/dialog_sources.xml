<?xml version="1.0" encoding="utf-8"?>
<!-- Choose a stream: poster header, Torrents / Direct links tabs, ranked list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="680dp"
    android:layout_height="wrap_content"
    android:background="@drawable/picker_panel"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/poster"
            android:layout_width="54dp"
            android:layout_height="81dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/quality_box"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/choose_stream"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.Pb.Label"
                android:textColor="@color/pbt_primary" />

            <TextView
                android:id="@+id/picker_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Pb.H1"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Pb.Meta"
                android:textColor="@color/pbt_text_muted" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/header_icon_bg"
            android:contentDescription="@string/refresh_sources"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="@color/pbt_text_muted" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/header_icon_bg"
            android:contentDescription="@android:string/cancel"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/pbt_text_muted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tab_torrents"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/picker_tab"
            android:focusable="true"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Pb.Button" />

        <TextView
            android:id="@+id/tab_direct"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/picker_tab"
            android:focusable="true"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Pb.Button" />
    </LinearLayout>

    <TextView
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/sources_note"
        android:textAppearance="@style/TextAppearance.Pb.Meta"
        android:textColor="@color/pbt_text_faint"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="330dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />
</LinearLayout>
