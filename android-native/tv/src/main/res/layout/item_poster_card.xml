<?xml version="1.0" encoding="utf-8"?>
<!-- Flutter PosterCard: 152×228, star chip, title+year, progress bar -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="168dp"
    android:layout_height="252dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:paddingStart="0dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/poster_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/poster_card_bg"
>

        <ImageView
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/poster_scrim" />

        <LinearLayout
            android:id="@+id/score_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/badge_score"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/score_star"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star" />

            <TextView
                android:id="@+id/score_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="@color/pb_white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/score_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="@color/pb_white54"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Liked / watched: one chip styled like the score chip (same glass,
             radius, height), matching the desktop apps. -->
        <LinearLayout
            android:id="@+id/state_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/badge_score"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingTop="3dp"
            android:paddingEnd="5dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/favorite_badge"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@string/liked"
                android:src="@drawable/ic_favorite"
                android:tint="@color/pb_state_liked"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/watched_badge"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="3dp"
                android:contentDescription="@string/watched"
                android:src="@drawable/ic_check"
                android:tint="@color/pb_accent"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="6dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="@color/pb_white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pb_white54"
                android:textSize="10sp" />
        </LinearLayout>
        <!-- Resume bar: inset inside the poster (and its focus ring) so the
             whole card, bar included, scales and stays within the rounded edge. -->
        <FrameLayout
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/progress_track_round"
            android:visibility="gone">

            <View
                android:id="@+id/progress_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/progress_fill_round" />
        </FrameLayout>
    </FrameLayout>

</FrameLayout>
