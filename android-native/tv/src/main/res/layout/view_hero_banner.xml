<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed hero matching Flutter HeroBannerFrame -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hero_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pb_canvas"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/hero_focus_ring_full"
    android:nextFocusDown="@id/main_browse_fragment">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Left scrim (Flutter stops) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_scrim_left" />

    <!-- Bottom fade into canvas -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_scrim_bottom" />

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/shelf_inset"
        android:layout_marginBottom="28dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hero_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/trending_now"
            android:textAllCaps="false"
            android:textColor="@color/pb_white54"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/hero_logo"
            android:layout_width="280dp"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitStart"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.05"
            android:maxLines="2"
            android:textColor="@color/pb_white"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hero_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/pb_white54"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/hero_synopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.4"
            android:maxLines="2"
            android:textColor="@color/pb_white54"
            android:textSize="15sp" />

        <!-- Single CTA — Flutter Details / user View more -->
        <TextView
            android:id="@+id/hero_view_more"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_primary"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="140dp"
            android:nextFocusDown="@id/main_browse_fragment"
            android:paddingHorizontal="24dp"
            android:text="@string/details"
            android:textColor="@color/pb_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Carousel dots -->
        <LinearLayout
            android:id="@+id/hero_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
