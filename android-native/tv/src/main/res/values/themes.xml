<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PeanutButter.Tv" parent="Theme.AppCompat.NoActionBar">
        <item name="android:colorPrimary">@color/pb_seed</item>
        <item name="android:colorAccent">@color/pb_seed</item>
        <item name="colorAccent">@color/pb_seed</item>
        <item name="android:windowBackground">@color/pb_canvas</item>
        <item name="android:windowFullscreen">true</item>
        <!-- Bundled Inter everywhere (Android 8+; older TVs keep the system font). -->
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:scrollbars">none</item>
        <item name="android:overScrollMode">never</item>
    </style>
</resources>
