<?xml version="1.0" encoding="utf-8"?>
<!-- The device square in the top bar (profile switcher later); blue ring when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFF0BC72" android:endColor="@color/pbt_primary" />
            <stroke android:width="@dimen/pbt_size_focus_ring" android:color="@color/pbt_focus" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFF0BC72" android:endColor="@color/pbt_primary" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
