<?xml version="1.0" encoding="utf-8"?>
<!-- Skip Intro / Play Next: same chip as the desktop player (dark, thin outline, white when focused). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF5B9FFF" />
            <stroke android:width="2dp" android:color="@color/pb_white" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#E0000000" />
            <stroke android:width="2.5dp" android:color="@color/pb_white" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#E0000000" />
            <stroke android:width="2dp" android:color="@color/pb_white" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B8000000" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
