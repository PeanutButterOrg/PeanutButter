<?xml version="1.0" encoding="utf-8"?>
<!-- A pick-one chip (Movies / Series, settings options): amber when chosen,
     outlined otherwise; blue ring when focused. Desktop: ChoiceChip. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pbt_primary" />
            <stroke android:width="@dimen/pbt_size_focus_ring" android:color="@color/pbt_focus" />
            <corners android:radius="@dimen/pbt_radius_pill" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pbt_primary" />
            <corners android:radius="@dimen/pbt_radius_pill" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="@dimen/pbt_size_focus_ring" android:color="@color/pbt_focus" />
            <corners android:radius="@dimen/pbt_radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF" />
            <stroke android:width="1dp" android:color="@color/pbt_line" />
            <corners android:radius="@dimen/pbt_radius_pill" />
        </shape>
    </item>
</selector>
