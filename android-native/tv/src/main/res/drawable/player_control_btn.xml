<?xml version="1.0" encoding="utf-8"?>
<!-- Transport / icon buttons: dark circle like the desktop player; white ring on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#FF5B9FFF" />
            <stroke android:width="2dp" android:color="@color/pb_white" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#E6000000" />
            <stroke android:width="2.5dp" android:color="@color/pb_white" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#9E000000" />
        </shape>
    </item>
</selector>
