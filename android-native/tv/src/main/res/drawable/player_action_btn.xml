<?xml version="1.0" encoding="utf-8"?>
<!-- Same focus palette as player_control_btn, pill shape for Skip / Play Next. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF5B9FFF" />
            <stroke
                android:width="2dp"
                android:color="@color/pb_white" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF5B9FFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#9E000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
