<?xml version="1.0" encoding="utf-8"?>
<!-- The best source: amber edge and a warm fade; blue ring when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#2EE2A456" android:centerColor="@color/pbt_surface_raised" android:endColor="@color/pbt_surface_raised" />
            <stroke android:width="@dimen/pbt_size_focus_ring" android:color="@color/pbt_focus" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#2EE2A456" android:centerColor="@color/pbt_surface_raised" android:endColor="@color/pbt_surface_raised" />
            <stroke android:width="1dp" android:color="@color/pbt_primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
