<?xml version="1.0" encoding="utf-8"?>
<!-- A filter picker (Type / Year / Rating / Genre), Netflix-style: a plain
     black box with a light outline; amber once something's picked; blue ring
     when focused. Desktop: AppMenuButton (compact). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="@dimen/pbt_size_focus_ring" android:color="@color/pbt_focus" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pbt_ground" />
            <stroke android:width="1dp" android:color="@color/pbt_primary" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pbt_ground" />
            <stroke android:width="1dp" android:color="#BFF1F3F7" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
