# PeanutButter Media Catalog — copy to .env and fill in your keys.
# Never commit a real .env file.

# --- Core ---
POSTGRES_USER=peanutbutter
POSTGRES_PASSWORD=peanutbutter
POSTGRES_DB=peanutbutter
DATABASE_URL=postgres://peanutbutter:peanutbutter@127.0.0.1:5433/peanutbutter

# Bind address for the Rust API (inside Docker use 0.0.0.0)
BIND_ADDR=0.0.0.0:3001

# Public URL used to build playback links (LAN IP, localhost, or your server)
# On a server this must be the URL clients use, e.g. http://10.0.0.28:3001
PUBLIC_URL=http://127.0.0.1:3001

# Host port for the API when using docker-compose.server.yml
API_PORT=3001

# Optional. Password for the server console at http://SERVER:3001/
# If empty, one is generated and printed in API logs on first boot.
ADMIN_PASSWORD=

# Optional. Six-digit pairing code for this server (TV-friendly).
# If empty, one is generated and shown in the console and API logs.
API_KEY=

# --- Search (Meilisearch) ---
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=peanutbutter_meili_master_key_change_me

# --- Metadata APIs (legal, official) ---
# The Movie Database — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OMDb — IMDb ratings only (do not scrape IMDb) — http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# AniList — optional; public GraphQL works without a client id
# https://anilist.co/settings/developer
ANILIST_CLIENT_ID=

# --- Local library ---
# Host path mounted into the API container. Contains your own media files.
MEDIA_PATH=./media

# Optional Jackett (reachable from the API). Prefer setting this in the
# server console after sign-in. These env vars overlay at boot if set.
# JACKETT_URL=http://host.docker.internal:9117
# JACKETT_API_KEY=

# Postgres is published on localhost:5433 in the local compose file only.
# docker-compose.server.yml does not publish the database.

# Sync schedule (cron). Defaults: popular every 6h, stale refresh nightly.
SYNC_CRON_POPULAR=0 0 */6 * * *
SYNC_CRON_STALE=0 30 3 * * *

# Logging: error, warn, info, debug, trace
RUST_LOG=peanutbutter=info,tower_http=info
